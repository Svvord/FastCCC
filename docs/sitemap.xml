---
layout: null
permalink: /sitemap.xml
nav_exclude: true
search_exclude: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- assign pages = site.html_pages | sort: "url" -%}
{%- for p in pages -%}
{%- if p.title and p.nav_exclude != true %}
  <url><loc>{{ p.url | absolute_url | xml_escape }}</loc></url>
{%- endif -%}
{%- endfor %}
</urlset>
